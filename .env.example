# Required: Groq API Key for the AI Matcher
VITE_GROQ_API_KEY=your_groq_api_key_here

# Search Configuration (Server-Side Only)
# Get your free API key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Adzuna API Keys for high-volume global job aggregation
VITE_ADZUNA_APP_ID=your_adzuna_app_id_here
VITE_ADZUNA_API_KEY=your_adzuna_api_key_here

# Firebase Configuration (Required for Google Auth & App functionality)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here